[Unit]
Description=Concordia household calendar aggregator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/concordiad -config /etc/concordia/config.toml
Restart=on-failure
RestartSec=5

User=concordia
Group=concordia
StateDirectory=concordia
ConfigurationDirectory=concordia

# OAuth client secret, encrypted at rest. Create with:
#   systemd-creds encrypt client_secret.json /etc/concordia/google_oauth.cred
# The runtime refresh token is written by the app to
# $STATE_DIRECTORY/tokens/<credential_ref>.json (0600).
LoadCredentialEncrypted=google_oauth:/etc/concordia/google_oauth.cred

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
